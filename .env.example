# GEMINI_API_KEY: Optional for server-side Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# APPWRITE CLIENT CONFIGURATION (Vite Frontend & Netlify)
# Copy these into .env.local and replace with your Appwrite IDs.
# See APPWRITE_SETUP.md for step-by-step instructions.
# ------------------------------------------------------------------
VITE_APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
VITE_APPWRITE_PROJECT_ID="YOUR_APPWRITE_PROJECT_ID"
VITE_APPWRITE_DATABASE_ID="YOUR_APPWRITE_DATABASE_ID"
VITE_APPWRITE_COLLECTION_ID="YOUR_APPWRITE_COLLECTION_ID"

# ------------------------------------------------------------------
# OPTIONAL SERVER-SIDE APPWRITE CONFIGURATION (Express server.ts)
# Never expose APPWRITE_API_KEY in frontend code or VITE_ variables.
# ------------------------------------------------------------------
APPWRITE_ENDPOINT="https://cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID="YOUR_APPWRITE_PROJECT_ID"
APPWRITE_DATABASE_ID="YOUR_APPWRITE_DATABASE_ID"
APPWRITE_COLLECTION_ID="YOUR_APPWRITE_COLLECTION_ID"
APPWRITE_API_KEY=""

# ------------------------------------------------------------------
# OPTIONAL SUPABASE CONFIGURATION (Alternative Database)
# ------------------------------------------------------------------
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
