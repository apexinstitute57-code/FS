# GEMINI_API_KEY: Optional for server-side Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# SUPABASE CLIENT CONFIGURATION (Vite Frontend & Netlify)
# Copy these into .env.local (local) or Netlify Environment Variables.
# Only use the Publishable / anon key here—NEVER expose service_role.
# See SUPABASE_SETUP.md for step-by-step instructions.
# ------------------------------------------------------------------
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# ------------------------------------------------------------------
# OPTIONAL SERVER-SIDE SUPABASE CONFIGURATION (Netlify Functions & Express)
# Never prefix SUPABASE_SERVICE_ROLE_KEY with VITE_.
# ------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
