# GEMINI_API_KEY: Optional for server-side Gemini features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# SUPABASE PUBLIC CLIENT CONFIGURATION (Recommended for Vite & Netlify)
# Paste your Project URL and Publishable (anon) Key into a local file
# named .env.local in the project root (never commit .env.local).
# ------------------------------------------------------------------
VITE_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# ------------------------------------------------------------------
# OPTIONAL SERVER-SIDE SUPABASE CONFIGURATION (Express server.ts)
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code or VITE_ vars.
# ------------------------------------------------------------------
SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY=""
